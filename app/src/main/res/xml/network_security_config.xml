<?xml version="1.0" encoding="utf-8"?>
<!--
    GameVox Network Security Configuration:
    1. Production base-config strictly forbids cleartext HTTP to public internet hosts
       (cleartextTrafficPermitted="false") and enforces TLS/HTTPS.
    2. Trusts system CAs and user-installed local development CAs (e.g. mkcert / self-signed LAN certs)
       for secure HTTPS connections to the local PC Chatterbox neural voice server.
    3. Provides a narrowly scoped cleartext exception ONLY for local loopback and private LAN
       development voice server addresses (such as 192.168.1.100) so local Wi-Fi testing works
       without globally enabling cleartext traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Localhost & Android Emulator host loopback -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">gamevox.local</domain>
        <domain includeSubdomains="true">chatterbox.local</domain>

        <!-- Scoped local LAN development voice server addresses (192.168.1.x / 192.168.0.x / 10.0.0.x) -->
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.1.101</domain>
        <domain includeSubdomains="false">192.168.1.102</domain>
        <domain includeSubdomains="false">192.168.1.103</domain>
        <domain includeSubdomains="false">192.168.1.104</domain>
        <domain includeSubdomains="false">192.168.1.105</domain>
        <domain includeSubdomains="false">192.168.1.106</domain>
        <domain includeSubdomains="false">192.168.1.107</domain>
        <domain includeSubdomains="false">192.168.1.108</domain>
        <domain includeSubdomains="false">192.168.1.109</domain>
        <domain includeSubdomains="false">192.168.1.110</domain>
        <domain includeSubdomains="false">192.168.1.2</domain>
        <domain includeSubdomains="false">192.168.1.10</domain>
        <domain includeSubdomains="false">192.168.1.20</domain>
        <domain includeSubdomains="false">192.168.1.50</domain>
        <domain includeSubdomains="false">192.168.0.100</domain>
        <domain includeSubdomains="false">192.168.0.101</domain>
        <domain includeSubdomains="false">192.168.0.102</domain>
        <domain includeSubdomains="false">192.168.0.103</domain>
        <domain includeSubdomains="false">192.168.0.104</domain>
        <domain includeSubdomains="false">192.168.0.105</domain>
        <domain includeSubdomains="false">10.0.0.100</domain>
        <domain includeSubdomains="false">10.0.0.2</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
