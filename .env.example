# GOOGLE_CLOUD_TTS_API_KEY: Optional API key for Google Cloud Text-to-Speech API (Neural2 / WaveNet).
# Configure securely via the Secrets panel in AI Studio.
GOOGLE_CLOUD_TTS_API_KEY=MY_GOOGLE_CLOUD_TTS_API_KEY

# OPENAI_TTS_API_KEY: Optional API key for OpenAI Audio Speech API (gpt-4o-mini-tts / tts-1-hd).
# Configure securely via the Secrets panel in AI Studio.
OPENAI_TTS_API_KEY=MY_OPENAI_TTS_API_KEY
